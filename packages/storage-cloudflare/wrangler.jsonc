// Test-only: the Worker the store's tests run in.
{
  "name": "storage-cloudflare-test",
  "main": "test/worker.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "TestStore" }] },
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "storage-cloudflare-test" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TestStore"] }]
}
